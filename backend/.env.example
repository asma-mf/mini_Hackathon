# -------------------------------------------------------
# Copy this file to .env and fill in the values
# -------------------------------------------------------

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/medicine_search

# JWT secret key — use a long random string in production
JWT_SECRET=xxx

# JWT expiry (default: 7d)
JWT_EXPIRES_IN=7d

# Port for the Express server (default: 5000)
PORT=5000

# React dev server origin(s) — comma-separated if multiple
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini 2.5 Flash — free tier via Google AI Studio
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
